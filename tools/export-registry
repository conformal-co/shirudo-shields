"""Generate catalog/shield-registry.json and the README shield table from shield.toml.

    tools/export-registry              print the registry JSON
    tools/export-registry --out FILE   write it to FILE
    tools/export-registry --write      rewrite catalog/shield-registry.json and the README table
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import shieldlib as sl  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--out", type=Path)
    group.add_argument("--write", action="store_true")
    args = parser.parse_args(argv)
    text = sl.render_registry()
    if args.write:
        sl.REGISTRY.parent.mkdir(parents=True, exist_ok=True)
        sl.REGISTRY.write_text(text, encoding="utf-8")
        sl.README.write_text(sl.splice_readme(sl.README.read_text(encoding="utf-8"), sl.readme_table()), encoding="utf-8")
        print(f"wrote {sl.REGISTRY.relative_to(sl.ROOT)} and the README table")
    elif args.out:
        args.out.write_text(text, encoding="utf-8")
    else:
        sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
