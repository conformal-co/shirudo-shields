  "$comment_upstream_kernels": "Kernels that track upstream stable releases, so a shield's [relevance] introduced/upstream_fixed apply to them by uname -r (relevance layer 3, before the [[affected.fixes]] rows). A host matches an entry when os_release.id (if given) lists its ID and uname -r matches uname_regex (POSIX ERE) and not uname_not_regex; unpackaged true matches instead a running kernel that no package of dpkg, rpm or pacman owns (/lib/modules/<uname -r>: self-built). The version compared is the leading major.minor[.patch] of uname -r. Backporting distributions (Debian, Ubuntu, RHEL and rebuilds, SUSE, Amazon Linux) are never listed.",
  "upstream_kernels": {
    "arch": {"name": "Arch Linux (linux, linux-lts, linux-zen, linux-hardened)", "os_release": {"id": ["arch", "endeavouros"]}, "uname_regex": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?-(arch[0-9]+-[0-9]+|[0-9]+-lts|zen[0-9]+-[0-9]+-zen|hardened[0-9]+-[0-9]+-hardened)$"},
    "fedora": {"name": "Fedora and Fedora CoreOS", "os_release": {"id": ["fedora"]}, "uname_regex": "^[0-9]+\\.[0-9]+\\.[0-9]+-[0-9]+\\.fc[0-9]+\\."},
    "flatcar": {"name": "Flatcar Container Linux", "os_release": {"id": ["flatcar"]}, "uname_regex": "^[0-9]+\\.[0-9]+\\.[0-9]+-flatcar$"},
    "ubuntu-mainline": {"name": "Ubuntu mainline kernel builds (kernel.ubuntu.com/mainline)", "uname_regex": "^[0-9]+\\.[0-9]+\\.[0-9]+-[0-9]{6}(rc[0-9]+)?-generic$"},
    "self-built": {"name": "Self-built kernel (no package owns its modules)", "unpackaged": true}
  }
